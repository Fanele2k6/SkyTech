@model CM_Project.Models.PaymentRequest
@{
    ViewBag.Title = "Complete Payment";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/PaymentStyle.css">
   
}

<!-- PayStack Inline JS — loaded once -->
<script src="https://js.paystack.co/v1/inline.js"></script>

<div class="pay-bg">
    <div class="pay-card">

        <!-- Header -->
        <div class="pay-card-head">
            <div class="pay-store-badge"><i class="fas fa-store"></i>SkyTech</div>
            <h2>Complete Your Payment</h2>
            <p>You're one step away from placing your order.</p>
            <div class="lock-ring"><i class="fas fa-lock"></i></div>
        </div>

        <!-- Body -->
        <div class="pay-body">

            <div class="info-row">
                <span class="key"><i class="fas fa-user"></i> Customer</span>
                <span class="val">@Model.CustomerName</span>
            </div>
            <div class="info-row">
                <span class="key"><i class="fas fa-envelope"></i> Email</span>
                <span class="val" style="font-size:.8rem">@Model.CustomerEmail</span>
            </div>
            <div class="info-row">
                <span class="key"><i class="fas fa-hashtag"></i> Order ID</span>
                <span class="val" style="color:#1a73e8">#@Model.OrderId</span>
            </div>

            <!-- Amount block -->
            <div class="pay-amount-block">
                <div class="pay-amount-label">TOTAL DUE</div>
                <div class="pay-amount-value"><span>R</span>@Model.Amount.ToString("N2")</div>
            </div>

            <!-- Pay button -->
            <button class="pay-btn" onclick="payWithPaystack(this)" id="payBtn">
                <i class="fas fa-lock"></i>
                <span id="btnText">Complete Payment</span>
                <div class="spinner" id="btnSpinner"></div>
            </button>

            <!-- Security note -->
            <div class="secure-strip">
                <i class="fas fa-shield-halved"></i>
                256-bit SSL encrypted &nbsp;·&nbsp; Powered by PayStack
                <i class="fas fa-credit-card"></i>
                Visa · Mastercard · USSD
            </div>

            <!-- Cancel -->
            <a href="@Url.Action("ViewCart","Customer")" class="cancel-link">
                <i class="fas fa-arrow-left" style="font-size:.7rem"></i> Cancel and go back
            </a>

        </div>
    </div>
</div>

<script>
function payWithPaystack(btn) {
    // Show spinner
    document.getElementById('btnText').textContent = 'Opening payment…';
    document.getElementById('btnSpinner').style.display = 'block';
    btn.disabled = true;

    var handler = PaystackPop.setup({
    key:      'pk_test_00e0ace8896dc183d605bed4ae78c29197fa3029',
        email:    '@Model.CustomerEmail',
        amount:   @(Math.Round(Model.Amount * 100)), //Added Math.Round
        ref:      'ORDER-@Model.OrderId-' + Math.floor(Math.random() * 1e9),
        currency: 'ZAR',

        callback: function(response) {
            window.location.href = '@Url.Action("Verify","Payment")?reference=' + response.reference;
        },

        onClose: function() {
            // Reset button
            document.getElementById('btnText').textContent = 'Pay R @Model.Amount.ToString("N2") Securely';
            document.getElementById('btnSpinner').style.display = 'none';
            btn.disabled = false;
        }
    });

    handler.openIframe();
}
</script>
