@model List<SkyTech.Models.SkytechWorkers.StaffPosition>
@{
    ViewData["Title"] = "Generate Weekly Roster";
}

<h1>Generate Weekly Roster</h1>

@if (!ViewData.ModelState.IsValid)
{
    <p>@Html.ValidationSummary()</p>
}

<div class="form-container">
    <form asp-controller="Roster" asp-action="GenerateWeekly" method="post">

        <div class="form-group">
            <label>Branch</label>
            <select name="branchId" asp-items="ViewBag.Branches">
                <option value="">--Select Branch--</option>
            </select>
        </div>

        <div class="form-group">
            <label>Week Starting (Monday)</label>
            <input type="date" name="weekStartDate" required />
            <small>The roster will cover this Monday through the following Sunday.</small>
        </div>

        <div class="form-group">
            <label>Shift Start Time</label>
            <input type="time" name="startTime" required />
        </div>

        <div class="form-group">
            <label>Shift End Time</label>
            <input type="time" name="endTime" required />
        </div>

        <h3>Staff Needed Per Day, By Position</h3>
        <p>Leave at 0 to skip a position entirely for this roster.</p>

        <table>
            <thead>
                <tr><th>Position</th><th>Staff Needed Per Day</th></tr>
            </thead>
            <tbody>
                @foreach (var position in Model)
                {
                    <tr>
                        <td>
                            @position.PositionName
                            <input type="hidden" name="positionIds" value="@position.PositionId" />
                        </td>
                        <td>
                            <input type="number" name="staffNeeded" min="0" value="0" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit">Generate Roster</button>
    </form>
</div>





