@using CM_Project.Models
@model IEnumerable<CM_Project.Models.ShopOwner>
@{
    ViewBag.Title = "Shop Applications";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";

    int total = Model.Count();
    int pending = Model.Count(o => o.ApplicationStatus == ApplicationStat.Pending);
    int approved = Model.Count(o => o.ApplicationStatus == ApplicationStat.Approved);
    int rejected = Model.Count(o => o.ApplicationStatus == ApplicationStat.Rejected);
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <link rel="stylesheet" href="~/CSS/ViewApplicationStyle.css">

    @*<style>
        /* ── PAGE ── */
        .admin-page { max-width: 1280px; margin: 0 auto; padding: 2rem 1.4rem 5rem; }

        /* ── TOPBAR ── */
        .admin-topbar { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem; }
        .admin-title  { font-family:'Clash Display','Plus Jakarta Sans',sans-serif;font-size:1.5rem;font-weight:700;color:#0e1b35;letter-spacing:-.4px; }
        .admin-sub    { font-size:.82rem;color:#8a96b0;margin-top:.15rem; }

        /* ── CHIPS ── */
        .chip-row { display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1.8rem; }
        .chip { background:#fff;border:1.5px solid #dde6f5;border-radius:12px;padding:.7rem 1.1rem;display:flex;align-items:center;gap:.6rem;box-shadow:0 2px 10px rgba(15,35,90,.06); }
        .chip .ch-num { font-family:'Clash Display','Plus Jakarta Sans',sans-serif;font-size:1.35rem;font-weight:700; }
        .chip .ch-lbl { font-size:.75rem;font-weight:700;color:#8a96b0; }
        .chip.blue   { border-color:rgba(26,115,232,.3);  } .chip.blue   .ch-num { color:#1a73e8; }
        .chip.yellow { border-color:rgba(217,119,6,.3);   } .chip.yellow .ch-num { color:#d97706; }
        .chip.green  { border-color:rgba(22,163,74,.3);   } .chip.green  .ch-num { color:#16a34a; }
        .chip.red    { border-color:rgba(220,38,38,.3);   } .chip.red    .ch-num { color:#dc2626; }

        /* ── SEARCH + FILTER ── */
        .toolbar { display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:1.2rem; }
        .so-search { position:relative;flex:1;min-width:220px; }
        .so-search i { position:absolute;left:.9rem;top:50%;transform:translateY(-50%);color:#8a96b0;font-size:.85rem;pointer-events:none; }
        .so-search input { width:100%;padding:.65rem 1rem .65rem 2.4rem;background:#fff;border:1.5px solid #dde6f5;border-radius:50px;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;color:#0e1b35;outline:none;transition:border-color .2s; }
        .so-search input:focus { border-color:#1a73e8; }
        .filter-btns { display:flex;gap:.45rem;flex-wrap:wrap; }
        .flt { padding:.48rem 1rem;border:1.5px solid #dde6f5;border-radius:50px;background:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.78rem;font-weight:700;color:#4a5878;cursor:pointer;transition:all .18s; }
        .flt:hover, .flt.active { background:#1a73e8;border-color:#1a73e8;color:#fff; }

        /* ── APPLICATION CARDS ── */
        .appl-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:1.2rem; }
        @media(max-width:600px){ .appl-grid{grid-template-columns:1fr} }

        .appl-card {
            background:#fff;border:1.5px solid #dde6f5;border-radius:20px;
            box-shadow:0 4px 18px rgba(15,35,90,.07);overflow:hidden;
            animation:fadeInUp .35s ease both;transition:box-shadow .2s,border-color .2s;
        }
        .appl-card:hover { border-color:rgba(26,115,232,.28);box-shadow:0 6px 28px rgba(26,115,232,.1); }
        @keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

        /* Card header strip */
        .ac-head {
            background:linear-gradient(135deg,#0a3d8f,#1a73e8);
            padding:1.1rem 1.3rem;display:flex;align-items:center;gap:.85rem;
        }
        .ac-avatar {
            width:44px;height:44px;border-radius:50%;
            background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.35);
            display:flex;align-items:center;justify-content:center;
            font-family:'Clash Display','Plus Jakarta Sans',sans-serif;
            font-size:1rem;font-weight:700;color:#fff;flex-shrink:0;
        }
        .ac-name { font-family:'Clash Display','Plus Jakarta Sans',sans-serif;font-size:.95rem;font-weight:700;color:#fff; }
        .ac-email { font-size:.72rem;color:rgba(255,255,255,.65);margin-top:.1rem; }
        .ac-head .badge { margin-left:auto;flex-shrink:0; }

        /* Card body rows */
        .ac-body { padding:1rem 1.3rem; }
        .ac-row { display:flex;align-items:flex-start;gap:.75rem;padding:.48rem 0;border-bottom:1px solid #dde6f5;font-size:.83rem; }
        .ac-row:last-of-type { border-bottom:none; }
        .ac-row .ak { color:#8a96b0;font-weight:700;min-width:130px;flex-shrink:0;display:flex;align-items:center;gap:.35rem;font-size:.78rem; }
        .ac-row .ak i { color:#1a73e8;font-size:.72rem; }
        .ac-row .av { color:#2d3e5c;font-weight:600;word-break:break-word; }
        .ac-row .av.mono { font-family:'Courier New',monospace;letter-spacing:.5px;font-size:.8rem; }

        /* Documents section */
        .ac-docs { padding:.8rem 1.3rem;background:#f7f9ff;border-top:1px solid #dde6f5;display:flex;flex-wrap:wrap;gap:.5rem;align-items:center; }
        .ac-docs .doc-label { font-size:.72rem;font-weight:700;color:#8a96b0;letter-spacing:.4px;width:100%;margin-bottom:.15rem; }
        .doc-link {
            display:inline-flex;align-items:center;gap:.35rem;
            padding:.3rem .8rem;background:#e8f1fd;border:1.5px solid rgba(26,115,232,.25);
            border-radius:20px;font-size:.75rem;font-weight:700;color:#1a73e8;text-decoration:none;
            transition:all .18s;
        }
        .doc-link:hover { background:#1a73e8;color:#fff; }
        .doc-none { font-size:.75rem;color:#8a96b0;font-style:italic; }

        /* Action buttons */
        .ac-actions { display:flex;gap:.65rem;padding:1rem 1.3rem;border-top:1px solid #dde6f5;background:#fafcff; }
        .btn-approve {
            flex:1;padding:.7rem;border:none;border-radius:50px;
            background:#16a34a;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;
            font-size:.85rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.4rem;
            box-shadow:0 3px 12px rgba(22,163,74,.25);transition:all .2s;
        }
        .btn-approve:hover { background:#15803d;transform:translateY(-1px);box-shadow:0 5px 18px rgba(22,163,74,.32); }
        .btn-reject {
            flex:1;padding:.7rem;border:1.5px solid rgba(220,38,38,.3);border-radius:50px;
            background:rgba(220,38,38,.06);color:#dc2626;font-family:'Plus Jakarta Sans',sans-serif;
            font-size:.85rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.4rem;
            transition:all .2s;
        }
        .btn-reject:hover { background:#dc2626;color:#fff;border-color:#dc2626; }

        /* BADGES */
        .badge { display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .7rem;border-radius:20px;font-size:.72rem;font-weight:700; }
        .badge::before { content:'';width:6px;height:6px;border-radius:50%; }
        .badge-pending  { background:rgba(217,119,6,.15); color:#92400e;border:1px solid rgba(217,119,6,.3); }
        .badge-pending::before  { background:#d97706; }
        .badge-approved { background:rgba(22,163,74,.12); color:#14532d;border:1px solid rgba(22,163,74,.3); }
        .badge-approved::before { background:#16a34a; }
        .badge-rejected { background:rgba(220,38,38,.1);  color:#7f1d1d;border:1px solid rgba(220,38,38,.25); }
        .badge-rejected::before { background:#dc2626; }

        /* Empty state */
        .admin-empty { text-align:center;padding:4rem 2rem;background:#fff;border:1.5px solid #dde6f5;border-radius:22px; }
        .admin-empty i { font-size:3.5rem;color:#1a73e8;opacity:.18;display:block;margin-bottom:1rem; }
        .admin-empty p { color:#8a96b0;font-weight:600; }
    </style>*@
}

<div class="admin-page">

    <!-- Topbar -->
    <div class="admin-topbar">
        <div>
            <div class="admin-title">Shop Owner Applications</div>
            <div class="admin-sub">Review and approve or reject shop registration requests.</div>
        </div>
    </div>

    <!-- Summary chips -->
    <div class="chip-row">
        <div class="chip blue">  <span class="ch-num">@total</span>   <span class="ch-lbl">Total</span></div>
        <div class="chip yellow"><span class="ch-num">@pending</span>  <span class="ch-lbl">Pending</span></div>
        <div class="chip green"> <span class="ch-num">@approved</span> <span class="ch-lbl">Approved</span></div>
        <div class="chip red">   <span class="ch-num">@rejected</span> <span class="ch-lbl">Rejected</span></div>
    </div>

    <!-- Search + filter toolbar -->
    <div class="toolbar">
        <div class="so-search">
            <i class="fas fa-magnifying-glass"></i>
            <input type="text" id="appSearch" placeholder="Search by name, shop, email…" oninput="filterCards(this.value)">
        </div>
        <div class="filter-btns">
            <button class="flt active" onclick="setFilter('all',this)">All</button>
            <button class="flt" onclick="setFilter('pending',this)">Pending</button>
            <button class="flt" onclick="setFilter('approved',this)">Approved</button>
            <button class="flt" onclick="setFilter('rejected',this)">Rejected</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty">
            <i class="fas fa-store"></i>
            <p>No shop owner applications found.</p>
        </div>
    }
    else
    {
        <div class="appl-grid" id="applGrid">
            @foreach (var item in Model)
            {
                string statusClass = item.ApplicationStatus == ApplicationStat.Approved ? "badge-approved"
                                   : item.ApplicationStatus == ApplicationStat.Rejected ? "badge-rejected"
                                                                                        : "badge-pending";
                string initials = ((item.Names?.Length > 0 ? item.Names[0].ToString() : "")
                                 + (item.Surname?.Length > 0 ? item.Surname[0].ToString() : "")).ToUpper();
                string filterTag = item.ApplicationStatus.ToString().ToLower();
                string searchTag = $"{item.Names} {item.Surname} {item.Email} {item.ShopName} {item.ApplicationStatus}".ToLower();
                bool isPending = item.ApplicationStatus == ApplicationStat.Pending;

                <div class="appl-card" data-filter="@filterTag" data-search="@searchTag">

                    <!-- Header -->
                    <div class="ac-head">
                        <div class="ac-avatar">@initials</div>
                        <div>
                            <div class="ac-name">@item.Names @item.Surname</div>
                            <div class="ac-email">@item.Email</div>
                        </div>
                        <span class="badge @statusClass">@item.ApplicationStatus</span>
                    </div>

                    <!-- Details -->
                    <div class="ac-body">
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-store"></i> Shop Name</span>
                            <span class="av" style="font-family:'Clash Display','Plus Jakarta Sans',sans-serif;font-weight:700;color:#0c5bc0">@item.ShopName</span>
                        </div>
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-id-card"></i> ID Number</span>
                            <span class="av mono">@item.IdBookNumber</span>
                        </div>
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-location-dot"></i> Shop Address</span>
                            <span class="av">@(item.ShopAddress ?? "—")</span>
                        </div>
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-location-pin"></i> Residential</span>
                            <span class="av">@item.ResidentialAddress</span>
                        </div>
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-building-columns"></i> Bank</span>
                            <span class="av">@item.BankType</span>
                        </div>
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-hashtag"></i> Account No.</span>
                            <span class="av mono">
                                @{
                                    var acct = item.AccountNumber ?? "";
                                    var masked = acct.Length > 4 ? new string('•', acct.Length - 4) + acct.Substring(acct.Length - 4) : acct;
                                }
                                @masked
                            </span>
                        </div>
                        @* <div class="ac-row">
                            <span class="ak"><i class="fas fa-shop"></i> Shop Type</span>
                            <span class="av">@(item.Shoptype ?? "—")</span>
                        </div> *@
                        <div class="ac-row">
                            <span class="ak"><i class="fas fa-calendar"></i> Registered</span>
                            <span class="av">@item.RegisteredOn.ToString("dd MMM yyyy · HH:mm")</span>
                        </div>
                    </div>

                    <!-- Documents -->
                    <div class="ac-docs">
                        <div class="doc-label"><i class="fas fa-paperclip" style="color:#1a73e8;margin-right:.3rem"></i>DOCUMENTS</div>

                        @if (item.BussRegCertificates != null && item.BussRegCertificates.Any())
                        {
                            foreach (var doc in item.BussRegCertificates)
                            {
                                @Html.ActionLink("Business Reg Cert", "DownloadBusRegCert", "SystemAdmin",
                                              new { id = doc.CertId }, new { @class = "doc-link", target = "_blank" })
                            }
                        }
                        else
                        { <span class="doc-none">No business cert</span>}

                        @if (item.OwnerIdentityBooks != null && item.OwnerIdentityBooks.Any())
                        {
                            foreach (var doc in item.OwnerIdentityBooks)
                            {
                                @Html.ActionLink("Identity Book", "DownloadOwnerID", "SystemAdmin",
                                              new { id = doc.OwnerIdentityBookId }, new { @class = "doc-link", target = "_blank" })
                            }
                        }
                        else
                        { <span class="doc-none">No ID book</span>}
                    </div>

                    <!-- Action buttons -->
                    <div class="ac-actions">
                       @if (isPending)
                        {
                            using (Html.BeginForm("ApproveAppl", "SystemAdmin", FormMethod.Post, new { style = "flex:1" }))
                            {
                                @Html.Hidden("id", item.OwnerId)
                                <button type="submit" class="btn-approve">
                                    <i class="fas fa-circle-check"></i> Approve
                                </button>
                            }

                            using (Html.BeginForm("RejectAppl", "SystemAdmin", FormMethod.Post, new { style = "flex:1" }))
                            {
                                @Html.Hidden("id", item.OwnerId)
                                <button type="submit" class="btn-reject"
                                        onclick="return confirm('Reject this application?')">
                                    <i class="fas fa-circle-xmark"></i> Reject
                                </button>
                            }
                        }
                        else
                        {
                            <div style="flex:1;text-align:center;font-size:.82rem;color:#8a96b0;font-weight:600;padding:.4rem 0">
                                @if (item.ApplicationStatus == ApplicationStat.Approved)
                                {
                                    <span style="color:#16a34a"><i class="fas fa-circle-check"></i> Approved</span>
                                }
                                else
                                {
                                    <span style="color:#dc2626"><i class="fas fa-circle-xmark"></i> Rejected</span>
                                }
                            </div>
                        }
                    </div>

                </div>
            }
        </div>
    }

</div>

<script>
    var currentFilter = 'all';
    var currentSearch = '';

    function setFilter(val, btn) {
        currentFilter = val;
        document.querySelectorAll('.flt').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
    }
    function filterCards(q) {
        currentSearch = q.toLowerCase();
        applyFilters();
    }
    function applyFilters() {
        document.querySelectorAll('#applGrid .appl-card').forEach(function (c) {
            var matchFilter = currentFilter === 'all' || c.dataset.filter === currentFilter;
            var matchSearch = !currentSearch || (c.dataset.search || '').includes(currentSearch);
            c.style.display = matchFilter && matchSearch ? '' : 'none';
        });
    }
</script>
