@using SkyTech.Models.JobPostServices.By_TRENCH
@model IEnumerable<LeaveRequest>

@{
    ViewData["Title"] = "Pending Leave Requests";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h2>Pending Leave Requests</h2>
            <small class="text-muted">Review and approve/reject employee leave requests</small>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-check-circle"></i> No pending leave requests. All requests have been reviewed.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var leave in Model)
            {
                int days = (int)(leave.EndDate - leave.StartDate).TotalDays + 1;
                <div class="col-md-6 mb-4">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">@leave.Staff.FirstName @leave.Staff.LastName</h5>
                            <small>@leave.LeaveType.Name - @days days</small>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Period:</strong>
                                <p>@leave.StartDate.ToString("MMM dd, yyyy") to @leave.EndDate.ToString("MMM dd, yyyy")</p>
                            </div>

                            <div class="mb-3">
                                <strong>Reason:</strong>
                                <p>@leave.Reason</p>
                            </div>

                            <div class="mb-3">
                                <strong>Applied:</strong>
                                <p>@leave.AppliedOn.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>

                            <div class="alert alert-info mb-3" role="alert">
                                <i class="fas fa-info-circle"></i>
                                <strong>Note:</strong> Approving this leave will mark the employee as "On Leave" and may trigger system recommendations for temporary staff.
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <form method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@leave.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" asp-action="ApproveLeave" class="btn btn-sm btn-success">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@leave.Id">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal@leave.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Reject Leave Request</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form method="post" asp-action="RejectLeave">
                                    <input type="hidden" name="id" value="@leave.Id" />
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Rejection Reason (Optional)</label>
                                            <textarea name="rejectionReason" class="form-control" rows="3" placeholder="Brief reason for rejection..."></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Reject Request</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>