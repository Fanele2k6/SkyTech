@using CM_Project.Models
@model CM_Project.Models.DeliveryDriver
@{
    ViewBag.Title = "Driver Dashboard";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";

     bool restricted = ViewBag.ApplicationStatus == ApplicationStat.Pending
                   || ViewBag.ApplicationStatus == ApplicationStat.Rejected;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DriverStyle.css">


}

<div class="d-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="d-sidebar">
        <div class="d-brand">
            <div class="d-brand-icon"><i class="fas fa-truck-fast"></i></div>
            <div>
                <div class="d-brand-name">SkyTech</div>
                <div class="d-brand-sub">Driver Portal</div>
            </div>
        </div>
        <nav class="d-nav">
            <div class="d-nav-label">NAVIGATION</div>
            <a href="@Url.Action("DriverDash", "DeliveryDriver")" class="d-link active")>
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>
            <a href="@Url.Action("MyDeliveries","DeliveryDriver")" class="d-link">
                <i class="fas fa-bag-shopping"></i><span>My Deliveries</span>
            </a>
            <div class="d-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("DriverProfile","DeliveryDriver")" class="d-link">
                <i class="fas fa-circle-user"></i><span>Profile</span>
            </a>
        </nav>
        <div class="d-sidebar-foot">
            <div class="d-foot-avatar"><i class="fas fa-user-tie"></i></div>
            <div>
                <div class="d-foot-name">Delivery Driver Name</div>
                <div class="d-foot-role">Delivery Driver</div>
            </div>
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <main class="d-main">

        <div class="d-topbar">
            <div>
                <div class="d-page-title">Driver Dashboard</div>
                <div class="d-page-sub">Here's a snapshot of your delivery activity.</div>
            </div>
            <div style="display:flex;align-items:center;gap:.6rem">
                <span class="badge" style="background:rgba(22,163,74,.1);color:#15803d;border:1px solid rgba(22,163,74,.25);font-size:.78rem;padding:.35rem .9rem">
                    <i class="fas fa-circle" style="font-size:.5rem;color:var(--green)"></i> Online
                </span>
            </div>
        </div>

        <!-- Stat cards -->
        <div class="d-stat-grid">
            @*<div class="d-stat teal">
                <div class="d-stat-icon"><i class="fas fa-bag-shopping"></i></div>
                <div class="d-stat-label">TOTAL DELIVERIES</div>
                <div class="d-stat-value">@(ViewBag.TotalDeliveries ?? 0)</div>
            </div>*@
            <div class="d-stat green">
                <div class="d-stat-icon"><i class="fas fa-circle-check"></i></div>
                <div class="d-stat-label">COMPLETED</div>
                <div class="d-stat-value">@(ViewBag.CompletedDeliveries ?? 0)</div>
            </div>
            <div class="d-stat yellow">
                <div class="d-stat-icon"><i class="fas fa-truck"></i></div>
                <div class="d-stat-label">IN PROGRESS</div>
                <div class="d-stat-value">@(ViewBag.InProgressDeliveries ?? 0)</div>
            </div>
        </div>

        <!-- Quick links -->
        <div class="d-card">
            <div class="d-card-head">
                <div class="d-card-title">Quick Actions</div>
            </div>
            <div class="d-card-body" style="display:flex;flex-wrap:wrap;gap:.75rem">
                <a href="@Url.Action("MyDeliveries","DeliveryDriver")" class="btn btn-primary">
                    <i class="fas fa-bag-shopping"></i> View My Deliveries
                </a>
                <a href="@Url.Action("DriverProfile","DeliveryDriver")" class="btn btn-outline">
                    <i class="fas fa-circle-user"></i> My Profile
                </a>
            </div>
        </div>

    </main>
</div>
