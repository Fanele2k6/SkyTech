@model RecruitmentSystem.ViewModels.AssessmentManagementViewModel

@{
    ViewData["Title"] = "Manage Assessment";
}

<h2>Manage Assessment</h2>

<hr />

<div class="card mb-4">
    <div class="card-body">

        <h3>@Model.Assessment.Title</h3>

        <p>
            <strong>Vacancy:</strong>
            @Model.Assessment.Job?.JobTitle
        </p>

        <p>
            <strong>Questions:</strong>
            @Model.QuestionCount
        </p>

        <p>
            <strong>Pass Mark:</strong>
            @Model.Assessment.PassMark%
        </p>

        <p>
            <strong>Time Limit:</strong>
            @Model.Assessment.TimeLimit minutes
        </p>

        <p>
            <strong>Status:</strong>

            @if (Model.Assessment.IsPublished)
            {
                <span class="badge bg-success">
                    Published
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">
                    Draft
                </span>
            }
        </p>

    </div>
</div>

@if (Model.Assessment.IsPublished)
{
    <div class="alert alert-success">
        <strong>Assessment is published.</strong>
        Applicants can currently write this assessment.
        <br />
        To make changes, unpublish the assessment first.
    </div>

    <div class="mb-3">

        <a asp-action="UnpublishAssessment"
           asp-route-id="@Model.Assessment.AssessmentId"
           class="btn btn-warning"
           onclick="return confirm('Unpublish this assessment? Applicants will no longer be able to write it until it is published again.');">
            Unpublish Assessment
        </a>

    </div>
}
else
{
    <a asp-action="EditAssessment"
       asp-route-id="@Model.Assessment.AssessmentId"
       class="btn btn-secondary">
        Edit Assessment Settings
    </a>
    <div class="alert alert-warning">
        <strong>Draft assessment.</strong>
        Applicants cannot access this assessment yet.
        You can add, edit or delete questions before publishing.
    </div>

    <div class="mb-3">

        <a asp-action="AddQuestion"
           asp-route-id="@Model.Assessment.AssessmentId"
           class="btn btn-success">
            + Add Question
        </a>

        @if (Model.QuestionCount > 0)
        {
            <a asp-action="PublishAssessment"
               asp-route-id="@Model.Assessment.AssessmentId"
               class="btn btn-primary"
               onclick="return confirm('Publish this assessment? Applicants will be able to write it after publishing.');">
                Publish Assessment
            </a>
        }

    </div>
}

<hr />

<h4>Questions</h4>

@if (!Model.Assessment.QuizQuestions.Any())
{
    <div class="alert alert-info">
        No questions have been added to this assessment yet.
    </div>
}
else
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>#</th>
                <th>Question</th>
                <th>Correct Answer</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @{
                int number = 1;
            }

            @foreach (var question in Model.Assessment.QuizQuestions)
            {
                <tr>

                    <td>
                        @number
                    </td>

                    <td>
                        @question.QuestionText
                    </td>

                    <td>
                        @question.CorrectAnswer
                    </td>

                    <td>

                        @if (!Model.Assessment.IsPublished)
                        {
                            <a asp-action="EditQuestion"
                               asp-route-id="@question.QuestionId"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a asp-action="DeleteQuestion"
                               asp-route-id="@question.QuestionId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this question?');">
                                Delete
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Unpublish to edit
                            </span>
                        }

                    </td>

                </tr>

                number++;
            }

        </tbody>

    </table>
}