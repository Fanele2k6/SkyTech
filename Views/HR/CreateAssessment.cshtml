@model RecruitmentSystem.ViewModels.CreateAssessmentViewModel

@{
    ViewData["Title"] = "Create Assessment";
}

<h2>Create Assessment</h2>

<form asp-action="CreateAssessment" method="post">

    <div class="mb-3">
        <label asp-for="JobId" class="form-label">Select Vacancy</label>

        <select asp-for="JobId"
                asp-items="Model.Jobs"
                class="form-control">
            <option value="">-- Select Vacancy --</option>
        </select>

        <span asp-validation-for="JobId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Assessment Title</label>

        <input asp-for="Title"
               class="form-control"
               placeholder="Example: Software Developer Assessment" />

        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PassMark"></label>

        <input asp-for="PassMark"
               class="form-control"
               type="number"
               min="1"
               max="100" />

        <span asp-validation-for="PassMark"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeLimit">
            Time Limit (Minutes)
        </label>

        <input asp-for="TimeLimit"
               class="form-control"
               type="number"
               min="1"
               max="180" />

        <span asp-validation-for="TimeLimit"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Quiz
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}