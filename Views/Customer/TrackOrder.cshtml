@model CM_Project.Models.Order
@using CM_Project.Models
@{
    ViewBag.Title = "TrackOrder";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";

    int currentStep = 0;
    string[] stepTimes = new string[] { null, null, null, null };

    if (Model != null)
    {
        if (Model.Status == OrderStatus.Pending) { currentStep = 0; }
        else if (Model.Status == OrderStatus.Assigned) { currentStep = 1; }
        else if (Model.Status == OrderStatus.OutForDelivery) { currentStep = 2; }
        else if (Model.Status == OrderStatus.Delivered) { currentStep = 3; }

        stepTimes[0] = Model.OrderedOn.ToString("hh:mm tt");
    }

    string[] iconPaths = new[]
    {
        @"<path d=""M9 12l2 2 4-4""/><rect x=""3"" y=""3"" width=""18"" height=""18"" rx=""4""/>",
        @"<circle cx=""12"" cy=""8"" r=""4""/><path d=""M6 20v-1a6 6 0 0 1 12 0v1""/>",
        @"<path d=""M5 12h14M12 5l7 7-7 7""/>",
        @"<path d=""M3 12l9-9 9 9""/><path d=""M9 21V12h6v9""/>"
    };

    var stepDefs = new[]
    {
        new { Name = "Order Placed",      Desc = "Your order has been received and confirmed." },
        new { Name = "Driver Assigned",   Desc = "A driver has been matched to your order."    },
        new { Name = "Out for Delivery",  Desc = "Your driver is on the way to your location." },
        new { Name = "Delivered",         Desc = "Your order has been delivered. Enjoy!"        },
    };
}


@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/CSS/TrackOrderStyle.css">
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Track Order</title>
    @* FIX 1: correct CSS filename was "order-tracking.css" — actual file is TrackOrderStyle.css *@
    @*<link href="@Url.Content("~/Content/CSS/TrackOrderStyle.css")" rel="stylesheet" />*@
</head>
<body>

    @* Hidden fields read by TrackOrderJS.js *@
    <input type="hidden" id="js-current-step" value="@currentStep" />
    <input type="hidden" id="js-order-id" value="@(Model != null ? Model.OrderId.ToString() : "")" />

    @* ── Header ─────────────────────────────────────────────── *@
    <header class="ot-header">
        @* FIX 2: back button pointed to Orders/Index — corrected to Customer controller *@
        <a href="@Url.Action("ShoppingPage", "Customer")" class="ot-back-btn" title="Back">&#8592;</a>
        <div>
            <div class="ot-header-title">Track your order</div>
            <div class="ot-header-sub">Live delivery status</div>
        </div>
    </header>

    <div class="ot-body">

        @* ── NULL MODEL ──────────────────────────────────────── *@
        @if (Model == null)
        {
            <div class="ot-card" style="text-align:center; padding: 2.5rem 1.5rem;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round"
                     style="margin-bottom:1rem; opacity:.4;">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <p style="margin:0 0 1.5rem; font-size:1rem; opacity:.7;">
                    @(ViewBag.Message ?? "No order information available.")
                </p>
                <a href="@Url.Action("ShoppingPage", "Customer")" class="ot-help-btn primary">
                    Back to Shop
                </a>
            </div>
        }
        else
        {
            @* ── Delivered banner ────────────────────────────────── *@
            <div class="ot-delivered-banner @(Model.Status == OrderStatus.Delivered ? "visible" : "")" id="deliveredBanner">
                <div class="ot-delivered-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5" />
                    </svg>
                </div>
                <div>
                    <div class="ot-delivered-title">Order delivered!</div>
                    <div class="ot-delivered-sub">Your package has arrived. Enjoy!</div>
                </div>
            </div>

            @* ── Order summary card ──────────────────────────────── *@
            <div class="ot-card">
                <div class="ot-summary">
                    <div>
                        <div class="ot-order-id">#ORD-@Model.OrderId</div>
                                                @* ── ADD THIS ── *@
                        @* @if (Model.ShopOwner != null)
                        { *@
                            <div class="ot-order-meta" style="margin-top:.3rem">
                                <i class="fas fa-store" style="color:#1a73e8;margin-right:.3rem"></i>
                                <strong>Store Address:</strong> @Model.ShopOwner.ShopAddress
                            </div>
                        @* } *@

                        <div class="ot-order-meta">
                            @(Model.OrderItems != null ? Model.OrderItems.Count : 0) item(s) &middot;
                            Placed @Model.OrderedOn.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                        <div class="ot-order-meta">
                            @(Model.OrderItems != null ? Model.OrderItems.Count : 0) item(s) &middot;
                            Placed @Model.OrderedOn.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                        <div class="ot-order-meta" style="margin-top:.5rem;
                             background:#f0fdf4;border-radius:8px;padding:.4rem .7rem;
                             display:inline-block">
                            <i class="fas fa-calendar-check" style="color:#16a34a"></i>
                            <strong>Estimated Delivery:</strong>
                            @Model.ScheduledDeliveryDate.ToString("dddd, dd MMM yyyy")
                        </div>
                        <div class="ot-order-meta">
                            <strong>Deliver to:</strong> @Model.DeliveryAddress
                        </div>
                    </div>
                    <div class="ot-eta-box">
                        <div class="ot-eta-label">Status</div>
                        <div class="ot-eta-value @(Model.Status == OrderStatus.Delivered ? "delivered" : "")" id="etaValue">
                            @ViewBag.StatusMessage
                        </div>
                    </div>
                </div>

                @* Four-segment progress strip *@
                <div class="ot-status-strip" id="statusStrip">
                    @for (int i = 0; i < 4; i++)
                    {
                        string fillWidth = i < currentStep ? "100%" : i == currentStep ? "50%" : "0%";
                        <div class="ot-strip-step">
                            <div class="ot-strip-fill" id="strip-@i" style="width:@fillWidth"></div>
                        </div>
                    }
                </div>
            </div>

            @* ── Tracker card ────────────────────────────────────── *@
            <div class="ot-card">
                <div class="ot-section-label">Delivery progress</div>

                <div class="ot-timeline" id="timeline">

                    @for (int i = 0; i < 4; i++)
                    {
                        string state = i < currentStep ? "done" : i == currentStep ? "active" : "pending";
                        bool isLast = (i == 3);
                        int fill = i < currentStep ? 100 : 0;

                        <div class="ot-step" id="step-@i">

                            @* Left: icon + connector *@
                            <div class="ot-step-left">
                                <div class="ot-icon @state" id="icon-@i">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        @Html.Raw(iconPaths[i])
                                    </svg>
                                </div>
                                @if (!isLast)
                                {
                                    <div class="ot-connector">
                                        <div class="ot-connector-fill" id="line-@i" style="height:@(fill)%"></div>
                                    </div>
                                }
                            </div>

                            @* Right: text *@
                            <div class="ot-step-content">
                                <div class="ot-step-name @state" id="name-@i">@stepDefs[i].Name</div>
                                <div class="ot-step-desc">@stepDefs[i].Desc</div>
                                <div class="ot-step-time" id="time-@i">
                                    @(stepTimes[i] ?? (i <= currentStep ? Model.OrderedOn.ToString("hh:mm tt") : "—"))
                                </div>

                                @* In-progress badge *@
                                @if (state == "active" && i < 3)
                                {
                                    <span class="ot-badge" id="badge-@i">In progress</span>
                                }

                                @* Driver card *@
                                @if (i == 1
                                    && (Model.Status == OrderStatus.Assigned || Model.Status == OrderStatus.OutForDelivery)
                                    && Model.Driver != null)
                                {
                                    string initials = "";
                                    if (!string.IsNullOrEmpty(Model.Driver.DriverName)) { initials += Model.Driver.DriverName[0]; }
                                    if (!string.IsNullOrEmpty(Model.Driver.DriverSurname)) { initials += Model.Driver.DriverSurname[0]; }

                                    <div class="ot-driver-card" id="driverCard">
                                        <div class="ot-driver-avatar">@initials.ToUpper()</div>
                                        <div>
                                            <div class="ot-driver-name">
                                                @(Model.Driver.DriverName ?? "") @(Model.Driver.DriverSurname ?? "")
                                            </div>
                                            <div class="ot-driver-vehicle">
                                                <i class="fas fa-car" style="color:#6b7280;margin-right:.3rem"></i>
                                                @(Model.Driver.VehicleType ?? "N/A") &middot; @(Model.Driver.VehicleNumber ?? "N/A")
                                            </div>
                                        </div>
                                        <div class="ot-driver-rating">
                                            <span class="ot-star">&#9733;</span> Assigned
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    }

                </div>
            </div>

            @* ── Order items ─────────────────────────────────────── *@
            @* FIX 3: was missing the @ symbol — "if" was being rendered as plain text *@
            if (Model.OrderItems != null && Model.OrderItems.Any())
            {
                <div class="ot-card">
                    <div class="ot-section-label">Order items</div>
                    <table class="ot-items-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProdName</td>
                                    <td>@item.Quantity</td>
                                    <td>R @item.PriceAtTimeOfPurchase.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="ot-total-label">Delivery fee</td>
                                <td class="ot-total-value" style="font-size:12px; font-weight:500; color:var(--text-secondary);">R50.00</td>
                            </tr>
                            <tr>
                                <td colspan="2" class="ot-total-label">Total</td>
                                <td class="ot-total-value">R @Model.TotalAmount.ToString("0.00")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @* ── Payment status ──────────────────────────────────── *@
            <div class="ot-card">
                <div class="ot-section-label">Payment</div>
                <div class="ot-payment-row">
                    <span class="ot-payment-label">Status</span>
                    @if (Model.IsPaid)
                    {
                        <span class="ot-payment-badge paid">Paid</span>
                    }
                    else
                    {
                        <span class="ot-payment-badge unpaid">Unpaid</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.PaymentReference))
                {
                    <div class="ot-payment-row" style="margin-top:8px;">
                        <span class="ot-payment-label">Reference</span>
                        <span class="ot-payment-ref">@Model.PaymentReference</span>
                    </div>
                }
            </div>

            @* ── Delivery Pin ────────────────────────────────────── *@
            @if (Model.Status != OrderStatus.Delivered)
            {
                <div class="ot-card">
                    <div class="ot-section-label">Delivery Pin</div>
                    <div style="text-align:center;padding:1rem 0">
                        <div style="font-size:.85rem;color:#6b7280;margin-bottom:.8rem">
                            <i class="fas fa-shield-halved" style="color:#1a73e8"></i>
                            Show this pin to your driver to confirm delivery
                        </div>
                        <div style="font-size:2.5rem;font-weight:800;letter-spacing:.6rem;
                                    color:#1a73e8;font-family:monospace;
                                    background:#f0f9ff;border:2px dashed #1a73e8;
                                    border-radius:12px;padding:.8rem 1.5rem;
                                    display:inline-block">
                            @Model.DeliveryPin
                        </div>
                        <div style="font-size:.75rem;color:#9ca3af;margin-top:.6rem">
                            Do not share this pin with anyone other than your driver
                        </div>
                    </div>
                </div>
            }


            @* ── Action buttons ──────────────────────────────────── *@
            <div class="ot-card ot-help-card">
                <div class="ot-help">
                    <a href="@Url.Action("ShoppingPage", "Customer")" class="ot-help-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        Contact support
                    </a>
                    <a href="@Url.Action("MyOrders", "Customer")" class="ot-help-btn primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <path d="M16 10a4 4 0 0 1-8 0" />
                        </svg>
                        My orders
                    </a>
                </div>
            </div>

        } @* end else (Model != null) *@

    </div>


    @* FIX 5: JS path is correct — ~/MyScripts/TrackOrderJS.js *@
    @if (Model != null)
    {
        <script src="@Url.Content("~/MyScripts/TrackOrderJS.js")"></script>
    }

</body>
</html>