@model CM_Project.ViewModels.AddProductViewModel
@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "Stock";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
}

<div class="so-wrap">

    <!-- SIDEBAR -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">SkyTech</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>
            <a href="@Url.Action("ShopOwnerDash","ShopOwner")" class="so-link"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>
            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage","ShopOwner")" class="so-link"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="so-link active"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>
            <a href="@Url.Action("ReceivedOrders","ShopOwner")" class="so-link"><i class="fas fa-bag-shopping"></i><span>Received Orders</span></a>
            <a href="@Url.Action("StaffReg","ShopOwner")" class="so-link"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers","ShopOwner")" class="so-link"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile","ShopOwner")" class="so-link"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-role">SkyTech</div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="so-main">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="so-alert so-alert-success"><i class="fas fa-circle-check"></i> @TempData["SuccessMessage"]</div>
        }

        <div class="so-topbar">
            <div>
                <div class="so-page-title">Edit Product</div>
                <div class="so-page-sub">Update product details and stock information.</div>
            </div>
            <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Back to Stock
            </a>
        </div>

        @using (Html.BeginForm("EditProductPage", "ShopOwner", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "so-alert so-alert-error" })

            <div class="so-card">
                <div class="so-card-head">
                    <div class="so-card-title"><i class="fas fa-pen-to-square" style="color:var(--blue);margin-right:.4rem"></i>Product Details</div>
                </div>
                <div class="so-card-body">
                    <div class="so-form-grid">

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-pen"></i> Product Name</label>
                            @Html.TextBoxFor(m => m.ProdName, new { @class = "so-input" })
                            @Html.ValidationMessageFor(m => m.ProdName, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-tag"></i> Category</label>
                            <select asp-for="ProdCategory" asp-items="Html.GetEnumSelectList<CM_Project.Models.SelectCategory>()" class="so-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.ProdCategory, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-tag"></i> Category</label>
                            <select asp-for="ProdType" asp-items="Html.GetEnumSelectList<CM_Project.Models.SelectType>()" class="so-select">
                                <option value="">-- Select Product Type --</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.ProdType, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-rand-sign"></i> Price (R)</label>
                            <div class="so-input-prefix-group">
                                <span class="so-input-prefix">R</span>
                                @Html.TextBoxFor(m => m.ProdPrice, new { @class = "so-input prefix-wrap" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ProdPrice, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-hashtag"></i> Quantity in Stock</label>
                            @Html.TextBoxFor(m => m.ProdQuantity, new { @class = "so-input", type = "number", min = "0" })
                            @Html.ValidationMessageFor(m => m.ProdQuantity, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-ruler"></i> Size / Weight</label>
                            @Html.TextBoxFor(m => m.ProdSize, new { @class = "so-input" })
                            @Html.ValidationMessageFor(m => m.ProdSize, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group span-2">
                            <label class="so-label"><i class="fas fa-align-left"></i> Description</label>
                            @Html.TextAreaFor(m => m.ProdDescription, new { @class = "so-textarea" })
                            @Html.ValidationMessageFor(m => m.ProdDescription, "", new { @class = "text-danger" })
                        </div>

                    </div>
                </div>
            </div>

            <!-- Image upload -->
            <div class="so-card" style="margin-top:1.2rem">
                <div class="so-card-head">
                    <div class="so-card-title"><i class="fas fa-image" style="color:var(--blue);margin-right:.4rem"></i>Replace Image <span style="font-size:.75rem;font-weight:400;color:var(--text-muted)">(optional — leave blank to keep existing)</span></div>
                </div>
                <div class="so-card-body">
                    <div class="so-file-card" style="position:relative" onclick="document.getElementById('picInput').click()">
                        <img id="imgPreview" class="preview-img" src="" alt="Preview">
                        <i class="fas fa-cloud-arrow-up" id="uploadIcon"></i>
                        <p id="uploadText">Click to upload a new image · JPG, PNG, JPEG</p>
                        <input type="file" id="picInput" name="ProductPicture" accept=".jpg,.png,.jpeg"
                               style="display:none" onchange="previewImg(this)">
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div style="display:flex;align-items:center;gap:1rem;margin-top:1.4rem;flex-wrap:wrap">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-floppy-disk"></i> Save Changes
                </button>
                <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="btn btn-outline btn-lg">
                    Cancel
                </a>
            </div>
        }
    </main>
</div>

<script>function previewImg(input) {
    var file = input.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        var img  = document.getElementById('imgPreview');
        img.src = e.target.result;
        img.style.display = 'block';
        document.getElementById('uploadIcon').style.display = 'none';
        document.getElementById('uploadText').textContent = file.name;
    };
    reader.readAsDataURL(file);
}</script>
