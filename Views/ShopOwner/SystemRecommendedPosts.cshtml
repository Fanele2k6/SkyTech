@using SkyTech.Models.JobPostServices.By_TRENCH
@using static SkyTech.Models.JobPostServices.By_TRENCH.Enums.StaffAnalysisEnums
@model IEnumerable<JobVacancyRecommendation>

@{
    ViewData["Title"] = "System Recommended Job Posts";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>System Recommended Job Posts</h2>
            <small class="text-muted">AI-generated recommendations pending your review</small>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("JobCenter", "ShopOwner")" class="btn btn-secondary">← Back to Job Center</a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No system recommendations available.
            Create a staffing analysis schedule to get AI-generated job posts.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Type</th>
                        <th>Headcount</th>
                        <th>Generated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rec in Model)
                    {
                        <tr>
                            <td>
                                <strong>@rec.SuggestedJobTitle</strong>
                            </td>
                            <td>@rec.Department.Name</td>
                            <td>
                                @if (rec.VacancyType == VacancyType.Permanent)
                                {
                                    <span class="badge bg-danger">Permanent</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Temporary</span>
                                    <br />
                                    <small>@rec.ContractDurationDays days</small>
                                }
                            </td>
                            <td><strong>@rec.RecommendedHeadcount</strong></td>
                            <td>@rec.GeneratedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a href="@Url.Action("ReviewRecommendation", new { id = rec.Id })" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>