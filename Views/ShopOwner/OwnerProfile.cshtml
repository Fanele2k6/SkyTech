@using CM_Project.Models
@model IEnumerable<CM_Project.Models.ShopOwner>
@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "Profile";
    var owner = Model?.FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
}

<div class="so-wrap">

    <!-- SIDEBAR -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">LOKAL</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>
            <a href="@Url.Action("ShopOwnerDash","ShopOwner")" class="so-link"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>
            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage","ShopOwner")" class="so-link"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="so-link"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>
            <a href="@Url.Action("ReceivedOrders","ShopOwner")" class="so-link"><i class="fas fa-bag-shopping"></i><span>Received Orders</span></a>
            <a href="@Url.Action("StaffReg","ShopOwner")" class="so-link"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers","ShopOwner")" class="so-link"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile","ShopOwner")" class="so-link active"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-name">@(owner?.ShopName ?? "My Shop")</div>
                <div class="so-foot-role">Shop Owner</div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="so-main">

        <div class="so-topbar">
            <div>
                <div class="so-page-title">My Profile</div>
                <div class="so-page-sub">Your account and shop information.</div>
            </div>
        </div>

        @if (owner == null)
        {
            <div class="so-alert so-alert-warning"><i class="fas fa-triangle-exclamation"></i> No profile data found.</div>
        }
        else
        {
            string statusClass = owner.ApplicationStatus == ApplicationStat.Approved ? "badge-approved"
                               : owner.ApplicationStatus == ApplicationStat.Rejected ? "badge-rejected"
                                                                                      : "badge-pending";

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;align-items:start">

                <!-- LEFT: Personal info -->
                <div>
                    <div class="so-card" style="overflow:hidden">
                        <div class="profile-hero">
                            <div class="profile-avatar"><i class="fas fa-user"></i></div>
                            <h2>@owner.Names @owner.Surname</h2>
                            <p>@owner.Email</p>
                            <span class="badge @statusClass" style="margin-top:.7rem">@owner.ApplicationStatus</span>
                        </div>
                        <div style="padding:1.4rem">
                            <div class="profile-row">
                                <span class="pk"><i class="fas fa-id-card" style="color:var(--blue);margin-right:.35rem"></i>ID Number</span>
                                <span class="pv">@owner.IdBookNumber</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk"><i class="fas fa-phone" style="color:var(--blue);margin-right:.35rem"></i>N/A</span>
                                <span class="pv" style="color:var(--text-muted);font-style:italic">Not provided</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk"><i class="fas fa-location-dot" style="color:var(--blue);margin-right:.35rem"></i>Residential Address</span>
                                <span class="pv">@owner.ResidentialAddress</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk"><i class="fas fa-calendar" style="color:var(--blue);margin-right:.35rem"></i>Registered</span>
                                <span class="pv">@owner.RegisteredOn.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Shop + Banking info -->
                <div style="display:flex;flex-direction:column;gap:1.2rem">

                    <!-- Shop info -->
                    <div class="so-card">
                        <div class="so-card-head">
                            <div class="so-card-title"><i class="fas fa-store" style="color:var(--blue);margin-right:.4rem"></i>Shop Information</div>
                        </div>
                        <div style="padding:.6rem 1.4rem 1.2rem">
                            <div class="profile-row">
                                <span class="pk">Shop Name</span>
                                <span class="pv" style="font-family:var(--font-display);font-size:1rem;font-weight:700;color:var(--blue-dark)">@owner.ShopName</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk">Shop Address</span>
                                <span class="pv">@(owner.ShopAddress ?? "Not provided")</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk">Shop Type</span>
                                <span class="pv">@(owner.Shoptype ?? "Not specified")</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk">Application Status</span>
                                <span class="badge @statusClass">@owner.ApplicationStatus</span>
                            </div>
                        </div>
                    </div>

                    <!-- Banking info -->
                    <div class="so-card">
                        <div class="so-card-head">
                            <div class="so-card-title"><i class="fas fa-building-columns" style="color:var(--blue);margin-right:.4rem"></i>Banking Details</div>
                        </div>
                        <div style="padding:.6rem 1.4rem 1.2rem">
                            <div class="profile-row">
                                <span class="pk">Bank</span>
                                <span class="pv">@owner.BankType</span>
                            </div>
                            <div class="profile-row">
                                <span class="pk">Account Number</span>
                                <span class="pv" style="font-family:'Courier New',monospace;letter-spacing:1px">
                                    @{
                                        var acct = owner.AccountNumber ?? "";
                                        var masked = acct.Length > 4
                                            ? new string('•', acct.Length - 4) + acct.Substring(acct.Length - 4)
                                            : acct;
                                    }
                                    @masked
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

          
        }

    </main>
</div>


