@using CM_Project.Models
@model IEnumerable<CM_Project.Models.Staff>
@{
    ViewBag.Title = "Staff Members";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "Staff";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <style>
        .staff-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(26,115,232,.12);
            border: 1.5px solid rgba(26,115,232,.25);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--blue);
            font-size: .85rem;
            font-weight: 700;
            flex-shrink: 0;
            font-family: var(--font-display);
        }
    </style>
}

<div class="so-wrap">

    <!-- SIDEBAR -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">LOKAL</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>
            <a href="@Url.Action("ShopOwnerDash","ShopOwner")" class="so-link"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>
            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage","ShopOwner")" class="so-link"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="so-link"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>
            <a href="@Url.Action("ReceivedOrders","ShopOwner")" class="so-link"><i class="fas fa-bag-shopping"></i><span>Received Orders</span></a>
            <a href="@Url.Action("StaffReg","ShopOwner")" class="so-link"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers","ShopOwner")" class="so-link active"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile","ShopOwner")" class="so-link"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-name">@(ViewBag.ShopName ?? "My Shop")</div>
                <div class="so-foot-role">Shop Owner</div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="so-main">

        <div class="so-topbar">
            <div>
                <div class="so-page-title">Staff Members</div>
                <div class="so-page-sub">@Model.Count() team member@(Model.Count() != 1 ? "s" : "") registered.</div>
            </div>
            <a href="@Url.Action("StaffReg","ShopOwner")" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Register Staff
            </a>
        </div>

        <div class="so-card">
            <div class="so-card-head">
                <div class="so-card-title"><i class="fas fa-users" style="color:var(--blue);margin-right:.4rem"></i>All Staff</div>
                <div class="so-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search staff…" oninput="filterRows(this.value)">
                </div>
            </div>
            <div class="so-table-wrap">
                <table class="so-table" id="staffTable">
                    <thead>
                        <tr>
                            <th>Staff Member</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            string initials = ((s.FirstName?.Length > 0 ? s.FirstName[0].ToString() : "") + (s.LastName?.Length > 0 ? s.LastName[0].ToString() : "")).ToUpper();
                            <tr data-search="@($"{s.FirstName} {s.LastName} {s.Email} {s.UserType}".ToLower())">
                                <td>
                                    <div style="display:flex;align-items:center;gap:.7rem">
                                        <div class="staff-avatar">@initials</div>
                                        <div>
                                            <div style="font-weight:700;color:var(--text)">@s.FirstName @s.LastName</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="color:var(--text-3);font-size:.85rem">@s.Email</td>
                                <td style="color:var(--text-3);font-size:.85rem">@s.PhoneNumber</td>
                                <td>
                                    <span class="badge badge-assigned">@(s.UserType ?? "Staff")</span>
                                </td>
                                <td style="font-size:.8rem;color:var(--text-muted)">@s.RegisteredOn.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div style="display:flex;gap:.5rem">
                                        <a href="@Url.Action("Edit","ShopOwner",new{id=s.StaffId})" class="btn btn-outline btn-sm">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <a href="@Url.Action("Delete","ShopOwner",new{id=s.StaffId})" class="btn btn-sm"
                                           style="background:rgba(220,38,38,.08);color:var(--red);border:1.5px solid rgba(220,38,38,.22);border-radius:var(--radius-pill)"
                                           onclick="return confirm('Remove this staff member?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div style="text-align:center;padding:4rem 2rem;color:var(--text-muted)">
                    <i class="fas fa-users" style="font-size:3rem;opacity:.2;display:block;margin-bottom:1rem"></i>
                    <p style="font-weight:600">No staff members yet.</p>
                    <a href="@Url.Action("StaffReg","ShopOwner")" class="btn btn-primary" style="margin-top:1rem">
                        <i class="fas fa-user-plus"></i> Register First Staff Member
                    </a>
                </div>
            }
        </div>

    </main>
</div>

<script>function filterRows(q) {
    var rows = document.querySelectorAll('#staffTable tbody tr');
    var term = q.toLowerCase();
    rows.forEach(function(r) {
        r.style.display = (r.dataset.search || '').includes(term) ? '' : 'none';
    });
}</script>
