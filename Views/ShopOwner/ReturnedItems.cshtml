@using CM_Project.Models
@model List<CM_Project.Models.OrderItem>
@{
    ViewBag.Title      = "Pending Returns";
    Layout             = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "Returns";

    int totalPending  = Model.Count;
    int refundCount   = Model.Count(i => i.RefundOrExchange == GetRefund.Refund);
    int exchangeCount = Model.Count(i => i.RefundOrExchange == GetRefund.Exchange_item);
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <link rel="stylesheet" href="~/CSS/ReturnedItemStyle.css">
}
<div class="so-wrap">

    <!-- ── SIDEBAR ── -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">LOKAL</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>
            <a href="@Url.Action("ShopOwnerDash","ShopOwner")" class="so-link"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>
            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage","ShopOwner")"      class="so-link"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage","ShopOwner")" class="so-link"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>
            <a href="@Url.Action("ReceivedOrders","ShopOwner")"  class="so-link"><i class="fas fa-bag-shopping"></i><span>Received Orders</span></a>
            <a href="@Url.Action("ReturnedItems","ShopOwner")"   class="so-link active"><i class="fas fa-rotate-left"></i><span>Returns</span></a>
            <a href="@Url.Action("StaffReg","ShopOwner")"        class="so-link"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers","ShopOwner")"    class="so-link"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile","ShopOwner")" class="so-link"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-name">@(ViewBag.ShopName ?? "My Shop")</div>
                <div class="so-foot-role">Shop Owner</div>
            </div>
        </div>
    </aside>

    <!-- ── MAIN ── -->
    <main class="so-main">

        @if (TempData["Message"] != null)
        {
            <div class="so-alert-success">
                <i class="fas fa-circle-check"></i> @TempData["Message"]
            </div>
        }

        <!-- Topbar -->
        <div class="so-topbar">
            <div>
                <div class="so-page-title">Pending Returns</div>
                <div class="so-page-sub">Customers requesting returns or exchanges from your store.</div>
            </div>
        </div>

        <!-- Summary chips -->
        <div class="chip-row">
            <div class="chip yellow"><span class="cn">@totalPending</span> <span class="cl">Pending</span></div>
            <div class="chip green"> <span class="cn">@refundCount</span>  <span class="cl">Want Refund</span></div>
            <div class="chip blue">  <span class="cn">@exchangeCount</span><span class="cl">Want Exchange</span></div>
        </div>

        <!-- Search -->
        <div class="toolbar">
            <div class="so-search">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" placeholder="Search by product, customer, order…"
                       oninput="filterCards(this.value)">
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="ret-empty">
                <i class="fas fa-rotate-left"></i>
                <h3>No pending returns</h3>
                <p>When customers submit return requests for your products, they will appear here.</p>
            </div>
        }
        else
        {
            <div id="retList">
                @foreach (var item in Model)
                {
                    string typePill  = item.RefundOrExchange == GetRefund.Refund
                                     ? "type-refund" : "type-exchange";
                    string typeLabel = item.RefundOrExchange == GetRefund.Refund
                                     ? "Refund" : "Exchange";
                    string typeIcon  = item.RefundOrExchange == GetRefund.Refund
                                     ? "fa-money-bill-wave" : "fa-arrow-right-arrow-left";

                    string custName  = item.Order?.Customers != null
                                     ? $"{item.Order.Customers.FirstName} {item.Order.Customers.LastName}"
                                     : "Customer";

                    string searchTag = $"{item.ProdName} {custName} {item.OrderId} {typeLabel}".ToLower();

                    <div class="ret-card" data-search="@searchTag">

                        <!-- Product + type -->
                        <div class="rc-top">
                            <div class="rc-thumb">
                                @if (item.Products?.ProductPictures != null && item.Products.ProductPictures.Any())
                                {
                                    var pic = item.Products.ProductPictures.First();
                                    <img src="@pic.FilePath" alt="@pic.FileName"/>
                                }
                                else { <i class="fas fa-image"></i> }
                            </div>
                            <div class="rc-info">
                                <div class="rc-name">@item.ProdName</div>
                                <div class="rc-meta">
                                    <span><i class="fas fa-hashtag"></i> Order #@item.OrderId</span>
                                    <span><i class="fas fa-user"></i>
                                        <span class="cust-chip">
                                            <i class="fas fa-circle-user" style="font-size:.65rem"></i>
                                            @custName
                                        </span>
                                    </span>
                                    <span class="type-pill @typePill">
                                        <i class="fas @typeIcon" style="font-size:.65rem"></i>
                                        @typeLabel Requested
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Detail cells -->
                        <div class="rc-details">
                            <div class="rc-detail-cell">
                                <div class="rdc-label">QTY TO RETURN</div>
                                <div class="rdc-value big">@item.QuantityReturned <span style="font-size:.75rem;color:#8a96b0;font-weight:500">of @item.Quantity purchased</span></div>
                            </div>
                            <div class="rc-detail-cell">
                                <div class="rdc-label">REFUND ESTIMATE</div>
                                <div class="rdc-value big">R @((item.PriceAtTimeOfPurchase * item.QuantityReturned).ToString("N2"))</div>
                            </div>
                            <div class="rc-detail-cell">
                                <div class="rdc-label">UNIT PRICE</div>
                                <div class="rdc-value">R @item.PriceAtTimeOfPurchase.ToString("N2")</div>
                            </div>
                            <div class="rc-detail-cell">
                                <div class="rdc-label">DELIVERED ON</div>
                                <div class="rdc-value">@(item.Order?.DeliveredOn?.ToString("dd MMM yyyy") ?? "—")</div>
                            </div>
                        </div>

                        <!-- Reason -->
                        <div class="rc-reason">
                            <i class="fas fa-comment-dots"></i>
                            <div>
                                <div style="font-size:.7rem;font-weight:700;color:#8a96b0;letter-spacing:.5px;margin-bottom:.2rem">CUSTOMER'S REASON</div>
                                @(string.IsNullOrWhiteSpace(item.RetunReason) ? "No reason provided." : item.RetunReason)
                            </div>
                        </div>

                        <!-- Footer — approve -->
                        <div class="rc-footer">
                            <div class="rc-order-ref">
                                <i class="fas fa-receipt"></i>
                                Order <span>#@item.OrderId</span>
                            </div>

                            @using (Html.BeginForm("ApproveReturn","ShopOwner",FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderItemId" value="@item.OrderItemId"/>
                                <button type="submit" class="btn-approve"
                                        onclick="return confirm('Approve return for \'@item.ProdName.Replace("'","\\'")\' ?')">
                                    <i class="fas fa-circle-check"></i> Approve Return
                                </button>
                            }
                        </div>

                    </div>
                }
            </div>
        }

    </main>
</div>

<script>
function filterCards(q) {
    var term  = q.toLowerCase();
    var cards = document.querySelectorAll('#retList .ret-card');
    cards.forEach(function(c) {
        c.style.display = (c.dataset.search || '').includes(term) ? '' : 'none';
    });
}
</script>
